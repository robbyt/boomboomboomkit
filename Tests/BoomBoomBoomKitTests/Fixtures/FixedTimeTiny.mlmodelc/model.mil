program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3605.1.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.11.0"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 1, 128, 1200]> input) {
            tensor<fp32, [4]> conv_bias = const()[name = string("conv_bias"), val = tensor<fp32, [4]>([-0x1.fdf76p-4, -0x1.1c494p-2, -0x1.c38666p-3, 0x1.279b3cp-3])];
            tensor<fp32, [4, 1, 3, 3]> conv_weight = const()[name = string("conv_weight"), val = tensor<fp32, [4, 1, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp32, [256]> fc_bias = const()[name = string("fc_bias"), val = tensor<fp32, [256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(320)))];
            tensor<fp32, [256, 4]> fc_weight = const()[name = string("fc_weight"), val = tensor<fp32, [256, 4]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1408)))];
            string input_1_pad_type_0 = const()[name = string("input_1_pad_type_0"), val = string("custom")];
            tensor<int32, [4]> input_1_pad_0 = const()[name = string("input_1_pad_0"), val = tensor<int32, [4]>([1, 1, 1, 1])];
            tensor<int32, [2]> input_1_strides_0 = const()[name = string("input_1_strides_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<int32, [2]> input_1_dilations_0 = const()[name = string("input_1_dilations_0"), val = tensor<int32, [2]>([1, 1])];
            int32 input_1_groups_0 = const()[name = string("input_1_groups_0"), val = int32(1)];
            tensor<fp32, [1, 4, 128, 1200]> input_1 = conv(bias = conv_bias, dilations = input_1_dilations_0, groups = input_1_groups_0, pad = input_1_pad_0, pad_type = input_1_pad_type_0, strides = input_1_strides_0, weight = conv_weight, x = input)[name = string("input_1")];
            tensor<fp32, [1, 4, 128, 1200]> input_3 = relu(x = input_1)[name = string("input_3")];
            tensor<int32, [2]> x_axes_0 = const()[name = string("x_axes_0"), val = tensor<int32, [2]>([-2, -1])];
            bool x_keep_dims_0 = const()[name = string("x_keep_dims_0"), val = bool(true)];
            tensor<fp32, [1, 4, 1, 1]> x = reduce_mean(axes = x_axes_0, keep_dims = x_keep_dims_0, x = input_3)[name = string("x")];
            tensor<int32, [2]> concat_0 = const()[name = string("concat_0"), val = tensor<int32, [2]>([1, 4])];
            tensor<fp32, [1, 4]> input_1_1 = reshape(shape = concat_0, x = x)[name = string("input")];
            tensor<fp32, [1, 256]> output = linear(bias = fc_bias, weight = fc_weight, x = input_1_1)[name = string("linear_0")];
        } -> (output);
}